# BuildCheck works without external services when this is true.
NEXT_PUBLIC_DEMO_MODE=true

# Optional future Supabase adapter (not required by the demo runtime).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Providers remain mock-first. Live sources require explicit per-analysis consent.
AI_PROVIDER=mock
# Values: mock | hacker-news | github | hacker-news+github | stack-exchange |
# apple-app-store | mastodon | bluesky | rss | npm | public-web
DATA_SOURCE_PROVIDER=mock
HN_SEARCH_TIMEOUT_MS=4500
GITHUB_SEARCH_TIMEOUT_MS=4500
PUBLIC_SOURCE_TIMEOUT_MS=4500
# Optional server-only token for higher GitHub API limits. Public search also works without it.
GITHUB_TOKEN=
# Optional Stack Apps key raises the anonymous Stack Exchange quota.
STACK_EXCHANGE_KEY=
STACK_EXCHANGE_SITE=stackoverflow
APP_STORE_COUNTRY=us
# Comma-separated public hostnames; defaults to mastodon.social when empty.
MASTODON_INSTANCES=
# Comma-separated administrator-selected public HTTPS feed URLs.
RSS_FEED_URLS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
