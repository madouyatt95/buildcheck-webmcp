# BuildCheck works without external services when this is true.
NEXT_PUBLIC_DEMO_MODE=true

# Optional future Supabase adapter (not required by the demo runtime).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Providers remain mock-first. Live sources require explicit per-analysis consent.
AI_PROVIDER=mock
# Values: mock | hacker-news | github | hacker-news+github
DATA_SOURCE_PROVIDER=mock
HN_SEARCH_TIMEOUT_MS=4500
GITHUB_SEARCH_TIMEOUT_MS=4500
# Optional server-only token for higher GitHub API limits. Public search also works without it.
GITHUB_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
